# SITES EVOLVE — server-side secrets. Never commit real values.
# Mandatory to activate the client portal and CRM:
DATABASE_URL=postgresql://postgres:password@localhost:5432/sites_evolve?sslmode=require
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Allowlist for studio owner(s), not a public registration form.
ADMIN_EMAILS=sites.evolve7@gmail.com

# Public site URL; canonical and sitemap use this on the deployed host.
NEXT_PUBLIC_SITE_URL=
LEAD_TO_EMAIL=sites.evolve7@gmail.com

# Optional delivery. Verify sending domain with Resend.
RESEND_API_KEY=
LEAD_FROM_EMAIL=

# Optional AI assistant. No key => truthful knowledge-base answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional private documents (Cloudflare R2; bucket must not be public).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional automation (HMAC-SHA256 signed events)
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=

# Optional scheduled uptime checks. Comma-separated public domain names.
CRON_SECRET=
MONITOR_ALLOWED_HOSTS=

# Optional Google Analytics, requires visitor opt-in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# For billing status only; does NOT constitute legal registration or a payment gateway.
BILLING_LEGAL_NAME=
BILLING_IDNO=

# Future founder portrait, after adding public/founder-portrait.webp to this repository
NEXT_PUBLIC_FOUNDER_PHOTO=

# Private Railway bucket / S3-compatible storage for client documents
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
